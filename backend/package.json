    "@verity/db": "workspace:*",
    "dotenv": "^17.4.2",
    "escrow-gate": "workspace:*",
    "fastify": "^5.12.5",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.6",
    "pg-boss": "^12.33.0",
    "pino": "^10.3.1",
    "zk-verifier-registry": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
